#!/bin/bash
set -eu

runtime_dir=/run/hedgeyos
process_dir=/run/hedgeyos-processes
session_log=${HEDGEYOS_SESSION_LOG:-/home/hedgeyos/Logs/xfce-session.log}

mkdir -p "$XDG_RUNTIME_DIR" "$runtime_dir" "$process_dir" \
    /home/hedgeyos/Downloads /home/hedgeyos/.cache/sessions
chmod 700 "$XDG_RUNTIME_DIR" "$process_dir"
rm -f /home/hedgeyos/.cache/sessions/*

export XDG_CONFIG_HOME=/home/hedgeyos/.config
export XDG_CACHE_HOME=/home/hedgeyos/.cache
export XDG_DATA_HOME=/home/hedgeyos/.local/share
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    printf '%s\n' "hedgeyos xfce startup: no D-Bus session address" >&2
    exit 70
fi

proc_start_ticks() {
    awk '{print $22}' "/proc/$1/stat" 2>/dev/null
}

dbus_pid=
parent_pid=$(awk '/^PPid:/ {print $2}' "/proc/$$/status")
for status in /proc/[0-9]*/status; do
    [ -r "$status" ] || continue
    candidate=${status#/proc/}
    candidate=${candidate%/status}
    [ "$(awk '/^PPid:/ {print $2}' "$status")" = "$parent_pid" ] || continue
    [ "$(cat "/proc/$candidate/comm" 2>/dev/null)" = dbus-daemon ] || continue
    dbus_pid=$candidate
    break
done

if [ -z "$dbus_pid" ]; then
    printf '%s\n' "hedgeyos xfce startup: could not identify the owned D-Bus daemon" >&2
    exit 70
fi

session_ticks=$(proc_start_ticks "$$")
dbus_ticks=$(proc_start_ticks "$dbus_pid")
if [ -z "$session_ticks" ] || [ -z "$dbus_ticks" ]; then
    printf '%s\n' "hedgeyos xfce startup: could not record process start identities" >&2
    exit 70
fi
export HEDGEYOS_SESSION_ID="${dbus_pid}:${session_ticks}"
export HEDGEYOS_XFCE_PID="$$"

umask 077
session_env_tmp="$runtime_dir/session.env.tmp.$$"
{
    printf "DBUS_SESSION_BUS_ADDRESS='%s'\n" \
        "$(printf '%s' "$DBUS_SESSION_BUS_ADDRESS" | sed "s/'/'\\\\''/g")"
    printf 'HEDGEYOS_DBUS_PID=%s\n' "$dbus_pid"
    printf 'HEDGEYOS_DBUS_START_TICKS=%s\n' "$dbus_ticks"
    printf 'HEDGEYOS_XFCE_PID=%s\n' "$$"
    printf 'HEDGEYOS_XFCE_START_TICKS=%s\n' "$session_ticks"
    printf "HEDGEYOS_SESSION_ID='%s'\n" "$HEDGEYOS_SESSION_ID"
} > "$session_env_tmp"
mv -f "$session_env_tmp" "$runtime_dir/session.env"

printf 'pid=%s\nstart_ticks=%s\ncomm=dbus-daemon\n' \
    "$dbus_pid" "$dbus_ticks" > "$process_dir/session-dbus.identity"
printf 'pid=%s\nstart_ticks=%s\ncomm=xfce4-session\n' \
    "$$" "$session_ticks" > "$process_dir/xfce-session.identity"

supervisor_pid=$(awk '/^PPid:/ {print $2}' "/proc/$parent_pid/status" 2>/dev/null || printf unknown)
startup_timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
lifecycle_tmp="/home/hedgeyos/Logs/.desktop-lifecycle.json.tmp.$$"
printf '{"state":"STARTING","supervisorPid":"%s","dbusPid":%s,"dbusAddress":"%s","xfcePid":%s,"startupTimestamp":"%s","shutdownRequested":false}\n' \
    "$supervisor_pid" "$dbus_pid" "$DBUS_SESSION_BUS_ADDRESS" "$$" \
    "$startup_timestamp" > "$lifecycle_tmp"
mv -f "$lifecycle_tmp" /home/hedgeyos/Logs/desktop-lifecycle.json

/usr/local/libexec/hedgeyos-bounded-log \
    --repair \
    --path "$session_log" \
    --max-bytes 1048576 \
    --rotations 3 \
    --legacy-threshold 8388608

exec > >(
    exec /usr/local/libexec/hedgeyos-bounded-log \
        --name desktop-session \
        --path "$session_log" \
        --max-bytes 1048576 \
        --rotations 3 \
        --rate-bytes-per-second 131072
) 2>&1

printf 'hedgeyos xfce startup: DISPLAY=%s XDG_RUNTIME_DIR=%s dbus_pid=%s\n' \
    "$DISPLAY" "$XDG_RUNTIME_DIR" "$dbus_pid"

/usr/local/libexec/hedgeyos-session-guard \
    --xfce-pid "$$" \
    --xfce-start-ticks "$session_ticks" \
    --dbus-pid "$dbus_pid" \
    --dbus-start-ticks "$dbus_ticks" &

# xinitrc performs the standard XFCE environment setup and then execs
# xfce4-session, preserving this exact process identity.
exec /etc/xdg/xfce4/xinitrc
